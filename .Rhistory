# Loading packages
library(tidyverse)
library(knitr)
# Reading the data
data <- read_csv("Toronto_apartment_rentals_2018.csv")
# Seeing how many duplicate rows there are
sum(duplicated(data)) # 308
# Viewing duplicate rows
data[duplicated(data) | duplicated(data, fromLast = TRUE), ]
# Cleaning the data
data <- data %>%
# Removing unnecessary columns
select(-c(Address, Lat, Long)) %>%
# Making the column names lowercase
rename_with(tolower) %>%
# Converting price to a number
mutate(price = parse_number(price)) %>%
# Removing outliers
filter(!price %in% c(65, 99, 99, 36900, 535000)) %>%
# Removing duplicate rows
distinct()
# Seeing if there are any NAs
colSums(is.na(data)) # 0
# Viewing summary stats of price
mean(data$price) # 2254.844
sd(data$price) # 1020.881
min(data$price) # 150
max(data$price) # 9750
# Viewing a histogram of price
data %>%
ggplot(aes(x = price)) +
geom_histogram(fill = "skyblue", bins = 20) +
labs(title = "Distribution of Toronto Monthly Apartment Rent (2018)",
x = "Monthly Rent",
y = "Frequency") +
geom_vline(aes(xintercept = mean(price)),
color = "black", linetype = "dashed", linewidth = 1) +
annotate("text",
x = 2255 + 200,
y = 80,
label = "Mean Rent: $2255",
color = "black",
hjust = 0) +
theme_minimal()
# Viewing frequencies of bed/bath/den
# TODO: put these in proper tables
table <- table(data$bedroom) # 3 levels
table(data$bathroom) # 5 levels
table(data$den) # 2 levels
kable(as.matrix(table),
caption = "Gears vs Cylinders Cross-tabulation")
kable(as.data.frame(table),
col.names = c("Number of Bedrooms", "Frequency"),
# caption = "",
align = "cc")
# Making boxplots of price by bed/bath/den count
# TODO: label axes, put title, make pretty
data %>%
mutate(bedroom = as.factor(bedroom)) %>%
ggplot(aes(x = bedroom, y = price)) +
geom_boxplot() +
theme_minimal()
data %>%
mutate(bathroom = as.factor(bathroom)) %>%
ggplot(aes(x = bathroom, y = price)) +
geom_boxplot()
data %>%
mutate(den = as.factor(den)) %>%
ggplot(aes(x = den, y = price)) +
geom_boxplot()
# Making scatterplots of price against bedroom and bathroom
# NOTE: these relationships don't seem very linear
data %>%
ggplot(aes(x = bedroom, y = price)) +
geom_point()
data %>%
ggplot(aes(x = bedroom, y = price)) +
geom_point()
# Making a correlation matrix
# NOTE: bed and bath are moderately correlated at r = 0.6365081
# NOTE: price and den aren't really correlated at r = 0.03690185
# TODO: make pretty by making it into a proper figure
cor(data)
