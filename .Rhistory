# Loading packages
library(tidyverse)
# Reading the data
data <- read_csv("Toronto_apartment_rentals_2018.csv")
# Seeing how many duplicate rows there are
# TODO: deal with this
sum(duplicated(data)) # 308
# Viewing duplicate rows
data %>%
group_by_all() %>%
filter(n() > 1) %>%
arrange(Address)
# Cleaning the data
data <- data %>%
# Removing unnecessary columns
select(-c(Address, Lat, Long)) %>%
# Converting price to a number
mutate(Price = parse_number(Price)) %>%
# Removing outliers
# NOTE: there's also two 99s I don't know if we should keep
filter(!Price %in% c(65, 36900, 535000)) %>%
# Removing duplicate rows
distinct()
# Seeing if there are any NAs
colSums(is.na(data)) # 0
data %>%
group_by_all() %>%
filter(n() > 1) %>%
arrange(Address)
data %>%
group_by_all() %>%
filter(n() > 1) %>%
ungroup() %>%
arrange(Address)
data %>%
group_by_all() %>%
filter(n() > 1) %>%
ungroup() # %>%
# Reading the data
data <- read_csv("Toronto_apartment_rentals_2018.csv")
# Seeing how many duplicate rows there are
# TODO: deal with this
sum(duplicated(data)) # 308
# Viewing duplicate rows
data %>%
group_by_all() %>%
filter(n() > 1) %>%
ungroup() %>%
arrange(Address)
data[duplicated(data) | duplicated(data, fromLast = TRUE), ]
mean(data$Price)
sd(data$Price)
min(data$Price)
max(data$Price)
