library(tidyverse)
library(janitor)
wages <- read.table("wage.txt")
wages <- row_to_names(wages, 1)
wages[] <- lapply(wages, as.numeric)
wages$occupation <- as.factor(wages$occupation)
cor(wages)
# Fitting another model
model_7 <- lm(wage ~ ., data = wages)
# Checking for multicollinearity
cor(select(wages, where(is.numeric), -wage))
# Checking for multicollinearity
cor(select(wages, where(is.numeric)))
# Fitting another model
model_7 <- lm(wage ~ ., data = wages)
summary(model_7)
wages <- read.table("wage.txt")
wages <- row_to_names(wages, 1)
wages[] <- lapply(wages, as.numeric)
wages$occupation <- as.factor(wages$occupation)
wages <- wages %>%
mutate(wage_binary = as.numeric(wage > mean(wage)))
model_8 <- glm(wage_binary ~ education, data = wages, family = "binomial")
summary(model_8)
