# Viewing a histogram of price
data %>%
ggplot(aes(x = price)) +
geom_histogram(fill = "skyblue", bins = 20) + # TODO: mean line
labs(x = "Monthly Rental Cost (2018)", y = "Frequency") +
geom_vline(aes(xintercept = mean(price)),
color = "black", linetype = "dashed", linewidth = 1) +
theme_minimal()
# Viewing a histogram of price
data %>%
ggplot(aes(x = price)) +
geom_histogram(fill = "skyblue", bins = 20) + # TODO: mean line
labs(x = "Monthly Rental Cost (2018)", y = "Frequency") +
geom_vline(aes(xintercept = mean(price)),
color = "black", linetype = "dashed", linewidth = 1) +
annotate("text",
x = mean(price) + 2,
y = 80,
label = paste("Mean Monthly Rent:", round(mean(price), 0)),
color = "black",
hjust = 0) +
theme_minimal()
